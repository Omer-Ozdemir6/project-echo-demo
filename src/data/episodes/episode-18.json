  "startNodeId": "ep18_n01",
  "episodeObjective": "Kapat.",

  "nodes": {

    "ep18_n01": {
      "id": "ep18_n01",
      "speaker": "JONES",
      "events": [
        { "type": "systemAlert", "text": "KATMAN KÖPRÜSÜ: YÜZEY — SABAH — TELSİZ AKTİF", "pauseAfterMs": 2500 },
        { "type": "realTimeWait", "seconds": 4 },
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Girişin önündeyim.", "pauseAfterMs": 4000 },
        { "type": "realTimeWait", "seconds": 8 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "İçerisi karanlık. Dışarısı güneşli. İkisi arasında duruyorum.", "pauseAfterMs": 4500 },
        { "type": "realTimeWait", "seconds": 6 },
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Selin uzaktan bakıyor. Yaklaşmadı. Doğru karar.", "pauseAfterMs": 4500 },
        { "type": "statChange", "changes": { "humanity": 5 } }
      ],
      "nextNodeId": "ep18_n02_bakar"
    },

    "ep18_n02_bakar": {
      "id": "ep18_n02_bakar",
      "speaker": "JONES",
      "events": [
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "İçeriye son kez baktım. Karanlık. Sadece karanlık.", "pauseAfterMs": 4000 },
        { "type": "realTimeWait", "seconds": 8 },
        { "type": "typing", "speaker": "JONES", "duration": 4000 },
        { "type": "message", "speaker": "JONES", "text": "EP04'te bu kapıyı açmak için taşı aktive etmiştim. Saatler sürmüştü. Emre'nin notu vardı. Semboller vardı. Puzzle vardı.", "pauseAfterMs": 5000 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Kapatmak için Emre'nin nasıl çalıştığını bilmek yeterliydi.", "pauseAfterMs": 4500 },
        { "type": "statChange", "changes": { "emreBaglantisi": 5, "humanity": 8 } }
      ],
      "nextNodeId": "ep18_n03_kisisel"
    },

    "ep18_n03_kisisel": {
      "id": "ep18_n03_kisisel",
      "speaker": "JONES",
      "events": [
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Cebimi karıştırdım. Otomatik olarak.", "pauseAfterMs": 3500 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Basın kartım. Hatay'dan, iki yıl önce. EP11'de buradaymış gibi görünmüştü. Sonra cebimde buldum.", "pauseAfterMs": 4500 },
        { "type": "statChange", "changes": { "humanity": 5 } }
      ],
      "choices": [
        { "id": "c_kisisel_koy",  "text": "Kartı cebine koy. Devam et.",           "nextNodeId": "ep18_n03_kisisel_b", "effects": { "mentalStability": 3 } },
        { "id": "c_kisisel_emre", "text": "Emre'nin söylediği bir şeyi hatırla.",  "nextNodeId": "ep18_n03_kisisel_b", "effects": { "emreBaglantisi": 5 } }
      ]
    },

    "ep18_n03_kisisel_b": {
      "id": "ep18_n03_kisisel_b",
      "speaker": "JONES",
      "events": [
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Hep benimdi. Sadece unutmuştum.", "pauseAfterMs": 4000 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Emre hep derdi ki: 'Kayıplarını bulmanın tek yolu aramayı bırakmak.' Bunu da unutmuştum.", "pauseAfterMs": 5000 },
        { "type": "statChange", "changes": { "humanity": 15, "emreBaglantisi": 5 } }
      ],
      "nextNodeId": "ep18_n04_konusur"
    },

    "ep18_n04_konusur": {
      "id": "ep18_n04_konusur",
      "speaker": "JONES",
      "events": [
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Girişe döndüm. Ve konuşmaya başladım.", "pauseAfterMs": 3500 },
        { "type": "realTimeWait", "seconds": 5 },
        { "type": "typing", "speaker": "JONES", "duration": 4000 },
        { "type": "message", "speaker": "JONES", "text": "\"Emre. Bilmiyorum duyup duymadığını. Sanırım duyuyorsun.\"", "pauseAfterMs": 4500 },
        { "type": "statChange", "changes": { "humanity": 5 } }
      ],
      "choices": [
        { "id": "c_konusur_devam",   "text": "Devam et. Söyle.",                   "nextNodeId": "ep18_n04_konusur_b", "effects": { "emreBaglantisi": 5 } },
        { "id": "c_konusur_sessizle","text": "Sessizce bekle. Bir an. Sonra söyle.", "nextNodeId": "ep18_n04_konusur_b", "effects": { "humanity": 5 } }
      ]
    },

    "ep18_n04_konusur_b": {
      "id": "ep18_n04_konusur_b",
      "speaker": "JONES",
      "events": [
        { "type": "realTimeWait", "seconds": 6 },
        { "type": "typing", "speaker": "JONES", "duration": 4500 },
        { "type": "message", "speaker": "JONES", "text": "\"Sana kızmıyorum. Seçimini anlayamıyorum ama saygı duyuyorum. Bu ikisi farklı şey.\"", "pauseAfterMs": 5000 },
        { "type": "realTimeWait", "seconds": 6 },
        { "type": "typing", "speaker": "JONES", "duration": 4000 },
        { "type": "message", "speaker": "JONES", "text": "\"Kafeteryada buluşmak istiyordum. Biliyorsun bunu. Ama olmayacak. Ve bu sefer gerçekten olmayacak.\"", "pauseAfterMs": 5500 },
        { "type": "realTimeWait", "seconds": 8 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Cevap gelmedi. Beklemedim de.", "pauseAfterMs": 4500 },
        { "type": "statChange", "changes": { "humanity": 20, "emreBaglantisi": -5 } }
      ],
      "nextNodeId": "ep18_n05_kapat"
    },

    "ep18_n05_kapat": {
      "id": "ep18_n05_kapat",
      "speaker": "JONES",
      "events": [
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Birinci kat girişindeki rezonans mekanizması. EP04'te açmıştım. Şimdi tersine çevirdim.", "pauseAfterMs": 4000 },
        { "type": "progressTask", "title": "REZONANS MEKANİZMASI — KAPATILIYOR", "duration": 5000 },
        { "type": "realTimeWait", "seconds": 5 },
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Taş hareket etti. Ağır. Yavaş.", "pauseAfterMs": 4000 },
        { "type": "realTimeWait", "seconds": 8 },
        { "type": "systemAlert", "text": "REZONANS MEKANİZMASI: KAPALI — GİRİŞ KİLİTLENDİ", "tone": "critical", "pauseAfterMs": 3000 },
        { "type": "realTimeWait", "seconds": 5 },
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Bitti.", "pauseAfterMs": 6000 },
        { "type": "statChange", "changes": { "memory": ["ep18_giris_kapatildi"] } }
      ],
      "nextNodeId": "ep18_n06_sessizlik"
    },

    "ep18_n06_sessizlik": {
      "id": "ep18_n06_sessizlik",
      "speaker": "JONES",
      "events": [
        { "type": "realTimeWait", "seconds": 6 },
        { "type": "typing", "speaker": "JONES", "duration": 2800 },
        { "type": "message", "speaker": "JONES", "text": "Telsiz açık. Ama hiçbir şey yok.", "pauseAfterMs": 4000 },
        { "type": "realTimeWait", "seconds": 8 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Dördüncü kattaki rezonans, üçüncü kattaki biyolüminesan frekans, Güneş'in kanalı — hepsi kesildi.", "pauseAfterMs": 5000 },
        { "type": "realTimeWait", "seconds": 6 },
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "EP01'den beri bu kadar sessiz olmamıştı telsiz.", "pauseAfterMs": 4500 },
        { "type": "realTimeWait", "seconds": 8 },
        {
          "type": "relationshipDialogue",
          "conditions": { "trust": { "gte": 60 } },
          "trueText": "Operatör. Sen de kesildin mi? Yoksa hâlâ orada mısın?",
          "falseText": "Sessizlik."
        },
        { "type": "statChange", "changes": { "humanity": 10 } }
      ],
      "nextNodeId": "ep18_n07_kamera"
    },

    "ep18_n07_kamera": {
      "id": "ep18_n07_kamera",
      "speaker": "JONES",
      "events": [
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Çantamdan kamerayı çıkardım. EP01'den beri orada. Hiç çalışmadı.", "pauseAfterMs": 4000 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Vizörden baktım. Girişin olduğu yere — şimdi sadece kayalık olan yere.", "pauseAfterMs": 4500 },
        { "type": "realTimeWait", "seconds": 6 },
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Deklanşöre bastım.", "pauseAfterMs": 3500 },
        { "type": "statChange", "changes": { "humanity": 5 } }
      ],
      "choices": [
        { "id": "c_kamera_bak",    "text": "Vizörden bak. Ne görüyorsun?",      "nextNodeId": "ep18_n07_kamera_b", "effects": { "curiosity": 5 } },
        { "id": "c_kamera_indir",  "text": "Vizörü indir. Bu yeterli.",          "nextNodeId": "ep18_n07_kamera_b", "effects": { "humanity": 5 } }
      ]
    },

    "ep18_n07_kamera_b": {
      "id": "ep18_n07_kamera_b",
      "speaker": "JONES",
      "events": [
        { "type": "realTimeWait", "seconds": 5 },
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Boş. Biliyordum zaten.", "pauseAfterMs": 3500 },
        { "type": "realTimeWait", "seconds": 5 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Ama bir şekilde... çektim.", "pauseAfterMs": 6000 },
        { "type": "statChange", "changes": { "humanity": 15 } }
      ],
      "nextNodeId": "ep18_son"
    },

    "ep18_son": {
      "id": "ep18_son",
      "speaker": "JONES",
      "events": [
        { "type": "realTimeWait", "seconds": 10 },
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Güneş doğuyor. Girişin olduğu yer artık kayalık.", "pauseAfterMs": 4500 },
        { "type": "realTimeWait", "seconds": 6 },
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Emre içeride.", "pauseAfterMs": 4500 },
        { "type": "realTimeWait", "seconds": 5 },
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Kendi seçimiyle.", "pauseAfterMs": 5000 },
        { "type": "realTimeWait", "seconds": 8 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Ve ben buradayım.", "pauseAfterMs": 5000 },
        { "type": "realTimeWait", "seconds": 6 },
        { "type": "typing", "speaker": "JONES", "duration": 4000 },
        { "type": "message", "speaker": "JONES", "text": "Kahve içmeyi öğreneceğim. Emre olmadan.", "pauseAfterMs": 6000 },
        { "type": "statChange", "changes": { "humanity": 20, "memory": ["ep18_kahve_ogrenecegim"] } },
        { "type": "realTimeWait", "seconds": 8 },
        { "type": "systemAlert", "text": "KATMAN — SON — 'KİLİT'", "tone": "waiting", "pauseAfterMs": 3000 }
      ],
      "choices": [
        { "id": "ep18_son_secim",  "text": "Hikaye sona erdi.",                             "nextNodeId": "ep18_kapanış" },
        { "id": "ep18_son_secim2", "text": "Kahve öğrenilir. Emre'siz de. Devam et.", "nextNodeId": "ep18_kapanış" }
      ]
    },

