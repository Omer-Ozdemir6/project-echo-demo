        { "type": "message", "speaker": "JONES", "text": "Tam bu noktada zeminde eski bir ekipman. Kayıt cihazı gibi.", "pauseAfterMs": 4000 },
        { "type": "statChange", "changes": { "curiosity": 12, "fear": 5 } }
      ],
      "nextNodeId": "ep12_n05_kaset"
