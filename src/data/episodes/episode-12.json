      "id": "ep12_n02_B",
      "speaker": "JONES",
      "events": [
        { "type": "message", "speaker": "JONES", "text": "Kıpırdamıyorum. Kapının arkasından hafif bir uğultu geliyor... sanki içeride birileri konuşuyor." },
        { "type": "realTimeWait", "seconds": 8 },
        { "type": "message", "speaker": "JONES", "text": "Açıyorum. Oda boş. Uğultu kesti." }
