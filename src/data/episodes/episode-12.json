        {
          "type": "relationshipDialogue",
          "conditions": { "emreDeğişim": { "gte": 100 } },
          "trueText": "Dördüncü kat. Ama farklı bir yer. Daha önce geldiğim koridorlar değil. Ya da geldiğim ve hatırlamadığım.",
