        { "type": "realTimeWait", "seconds": 3 },
        { "type": "message", "speaker": "JONES", "text": "Elimden not düştü... Parmaklarım titriyor operatör. Yazıyı ikinci kez okuyorum. Hâlâ aynı şey yazıyor." },
