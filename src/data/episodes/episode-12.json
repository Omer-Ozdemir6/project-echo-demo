      "events": [
        { "type": "message", "speaker": "JONES", "text": "Bu bakış... tanıdık." },
        { "type": "message", "speaker": "SELİN", "text": "Jones. Acele etme. Biliyorum. Şu an panik yapıyorsun. Birlikte düşünelim." },
        { "type": "realTimeWait", "seconds": 8 },
        { "type": "message", "speaker": "JONES", "text": "Arkamda biri var." },
        { "type": "realTimeWait", "seconds": 4 },
        { "type": "message", "speaker": "JONES", "text": "Az önce odada iki kişinin nefes sesi vardı. Şimdi sadece biri kaldı. Ben konuşmuyordum..." },
        { "type": "realTimeWait", "seconds": 6 },
        { "type": "message", "speaker": "JONES", "text": "Dönüyorum. Kimse yok." }
      ],
      "nextNodeId": "ep12_n07_final"
