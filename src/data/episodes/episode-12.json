        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Erken çizikler düzenli. Sonrakiler daha hızlı, daha derin. Birinin hali değişmiş zamanla.", "pauseAfterMs": 5000 },
