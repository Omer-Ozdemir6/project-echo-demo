          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Dördüncü kat. Ama farklı bir yer. Daha önce geldiğim koridorlar değil.",
          "pauseAfterMs": 4000,
          "textKey": "episode_12.ep12_n01.event6.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Turuncu ışık burada soluk. Neredeyse gri. Duvarlar dar. Ve her iki yanda — çizikler.",
          "pauseAfterMs": 4500,
          "textKey": "episode_12.ep12_n01.event8.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 6
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Binlerce çizik. Zemin seviyesinden tavana kadar.",
          "pauseAfterMs": 4500,
          "textKey": "episode_12.ep12_n01.event11.text"
        },
        {
          "type": "statChange",
          "changes": {
            "fear": 8,
            "curiosity": 12
          },
          "pauseAfterMs": 100
        }
      ],
      "choices": [
        {
          "id": "c1_cizikler",
          "text": "Çizikleri takip et. Sol duvardan başla.",
