        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Turuncu ışık burada soluk. Neredeyse gri. Duvarlar dar. Ve her iki yanda — çizikler.", "pauseAfterMs": 4500 },
        { "type": "realTimeWait", "seconds": 6 },
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Binlerce çizik. Zemin seviyesinden tavana kadar.", "pauseAfterMs": 4500 },
