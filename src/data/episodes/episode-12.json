        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Saymaya başladım. Onlar, yirmiler, elliler... yüzde durdum.", "pauseAfterMs": 4000 },
