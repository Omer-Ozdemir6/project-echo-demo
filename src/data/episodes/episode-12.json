    "ep12_n03_oda": {
      "id": "ep12_n03_oda",
      "speaker": "JONES",
      "events": [
        { "type": "message", "speaker": "JONES", "text": "İki sandalye. Bir masa. Kırık bir teyp." },
        { "type": "realTimeWait", "seconds": 8 },
        { "type": "message", "speaker": "JONES", "text": "Masanın başına oturdum. İskambil kartları hâlâ dizili." },
        { "type": "realTimeWait", "seconds": 4 },
        { "type": "message", "speaker": "JONES", "text": "Sanki biraz önce biri kalkıp gitmiş. Burası bir gözlem odası... Buraya gelenleri mi izliyorlardı?" }
      ],
      "nextNodeId": "ep12_n04_duvar"
    },

    "ep12_n04_duvar": {
      "id": "ep12_n04_duvar",
      "speaker": "JONES",
      "events": [
        { "type": "message", "speaker": "JONES", "text": "Duvar boyunca binlerce çizik. Her biri bir gün." },
        { "type": "realTimeWait", "seconds": 6 },
        { "type": "message", "speaker": "JONES", "text": "Çizikler... Saymayı bıraktım." },
        { "type": "realTimeWait", "seconds": 4 },
        { "type": "message", "speaker": "JONES", "text": "Eğer her biri bir günü temsil ediyorsa... burada çok uzun süre kalmış biri var." }
      ],
      "nextNodeId": "ep12_n05_ses_kaydi"
    },

