        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Sol duvardan başladım. Parmağımla bir çiziğin üzerinden geçtim.", "pauseAfterMs": 3500 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
