          "effects": {
            "fear": 5,
            "curiosity": 8
          },
          "textKey": "episode_12.ep12_n01.choice1.text"
        }
      ]
    },
    "ep12_A01": {
      "id": "ep12_A01",
      "speaker": "JONES",
      "events": [
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Sol duvardan başladım. Parmağımla bir çiziğin üzerinden geçtim.",
          "pauseAfterMs": 3500,
          "textKey": "episode_12.ep12_A01.event1.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Derin. Bir aletle değil, tırnakla yapılmış. Uzun süre burada kalan biri.",
          "pauseAfterMs": 4000,
          "textKey": "episode_12.ep12_A01.event3.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 5
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Saymaya başladım. Onlar, yirmiler, elliler... yüzde durdum.",
          "pauseAfterMs": 4000,
          "textKey": "episode_12.ep12_A01.event6.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Saymayı bıraktım. Önemli olan sayı değil zaten.",
          "pauseAfterMs": 4500,
          "textKey": "episode_12.ep12_A01.event8.text"
        },
        {
          "type": "statChange",
          "changes": {
            "humanity": 10,
            "curiosity": 8
          },
          "pauseAfterMs": 100
        }
      ],
      "nextNodeId": "ep12_A02"
    },
    "ep12_A02": {
      "id": "ep12_A02",
      "speaker": "JONES",
      "events": [
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Yere baktım. Zemin tozu. Ve bir iz — biri burada uzun süre oturmuş.",
          "pauseAfterMs": 4000,
          "textKey": "episode_12.ep12_A02.event1.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 4000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Sol kalça daha fazla baskı yapmış. Sol elini duvara koymuş, sağ eliyle çizmiş. Fotoğrafçıyım — bu tür şeyleri görürüm.",
          "pauseAfterMs": 5000,
          "textKey": "episode_12.ep12_A02.event3.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 6
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Erken çizikler düzenli. Sonrakiler daha hızlı, daha derin. Birinin hali değişmiş zamanla.",
          "pauseAfterMs": 5000,
          "textKey": "episode_12.ep12_A02.event6.text"
        },
        {
          "type": "statChange",
          "changes": {
            "humanity": 15,
            "fear": 8
          },
          "pauseAfterMs": 100
        }
      ],
      "nextNodeId": "ep12_A03"
    },
    "ep12_A03": {
      "id": "ep12_A03",
      "speaker": "JONES",
      "events": [
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Çizikler koridorun ortasında bir noktada durmuş. Orada terk edilmiş.",
