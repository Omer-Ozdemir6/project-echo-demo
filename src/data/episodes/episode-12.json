          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Kayıt cihazı. Pil mi, jeneratör mü bilemiyorum. Çalışıyor.",
