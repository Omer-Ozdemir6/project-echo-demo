    "ep12_A02": {
      "id": "ep12_A02",
      "speaker": "JONES",
      "events": [
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Yere baktım. Zemin tozu. Ve bir iz — biri burada uzun süre oturmuş.", "pauseAfterMs": 4000 },
        { "type": "typing", "speaker": "JONES", "duration": 4000 },
        { "type": "message", "speaker": "JONES", "text": "Sol kalça daha fazla baskı yapmış. Sol elini duvara koymuş, sağ eliyle çizmiş. Fotoğrafçıyım — bu tür şeyleri görürüm.", "pauseAfterMs": 5000 },
