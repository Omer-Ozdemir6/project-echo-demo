          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Tam bu noktada zeminde eski bir ekipman. Kayıt cihazı gibi.",
          "pauseAfterMs": 4000,
          "textKey": "episode_12.ep12_A03.event6.text"
        },
        {
          "type": "statChange",
          "changes": {
