      "speaker": "EMRE",
      "events": [
        { "type": "message", "speaker": "JONES", "text": "Masanın altında bir cihaz. Çalışıyor." },
        { "type": "realTimeWait", "seconds": 6 },
        { "type": "message", "speaker": "EMRE", "text": "(Kayıt) Eğer bunu dinliyorsan... demek yine aynı yere geldin. Ben de ilk seferinde inanmamıştım. Sonra sen bana... Boşver. Zaten birazdan unutacaksın." },
        { "type": "realTimeWait", "seconds": 6 },
        { "type": "message", "speaker": "JONES", "text": "(Sessizlik.)" },
        { "type": "realTimeWait", "seconds": 4 },
        { "type": "message", "speaker": "JONES", "text": "Bitti mi?" }
      ],
      "nextNodeId": "ep12_n06_puzzle_giris"
