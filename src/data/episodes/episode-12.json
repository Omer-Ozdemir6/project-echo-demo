      "id": "ep12_n02_A",
      "speaker": "JONES",
      "events": [
        { "type": "message", "speaker": "JONES", "text": "Zorluyorum. Metal gıcırtıyla açılıyor." },
        { "type": "realTimeWait", "seconds": 4 },
        { "type": "message", "speaker": "JONES", "text": "Küçük bir oda. Masanın üzerinde... bir not var. Hemen gözüme çarpıyor." }
