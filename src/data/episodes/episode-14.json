          "textKey": "episode_14.ep14_A01.event6.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Ve sen\" dedi.",
          "pauseAfterMs": 5000,
          "textKey": "episode_14.ep14_A01.event8.text"
        },
        {
          "type": "statChange",
          "changes": {
