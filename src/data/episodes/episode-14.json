          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Sıcaklık düştü. Aniden.",
          "pauseAfterMs": 3500,
          "textKey": "episode_14.ep14_n05_inis.event6.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 5
