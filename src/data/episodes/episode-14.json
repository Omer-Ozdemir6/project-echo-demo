    "ep14_A02": {
      "id": "ep14_A02",
      "speaker": "JONES",
      "events": [
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Ne yapmamamı söylersin?\"",
          "pauseAfterMs": 3500,
          "textKey": "episode_14.ep14_A02.event1.text"
        },
        {
          "type": "realTimeWait",
