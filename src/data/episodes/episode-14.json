          "textKey": "episode_14.ep14_n06_besinci.event5.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Güneş yanımda. \"Duvara bakma\" dedi. \"Köşenden bak.\"",
          "pauseAfterMs": 4000,
          "textKey": "episode_14.ep14_n06_besinci.event7.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Anlamadım. Ama yaptım.",
          "pauseAfterMs": 4000,
          "textKey": "episode_14.ep14_n06_besinci.event9.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 6
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 4000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Duvar... tarif edemiyorum. Fotoğraf olsaydı bir kelime etmezdim.",
          "pauseAfterMs": 3500,
          "textKey": "episode_14.ep14_n06_besinci.event12.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Arızalı fotoğrafçıyım. Kelimelerle yapmam lazım bunu.",
          "pauseAfterMs": 3500,
          "textKey": "episode_14.ep14_n06_besinci.event14.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 2500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Güneş: \"Neden anlatıyorsun?\"",
          "pauseAfterMs": 3000,
          "textKey": "episode_14.ep14_n06_besinci.event16.text"
