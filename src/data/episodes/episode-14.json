          "type": "typing",
          "speaker": "JONES",
          "duration": 4500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"432 Hz'i kesme\" dedi. \"Hiç. İnersek, çıkarsak, nerede olursan ol. Keseceğini hissedersen bana söyle. Önce bana.\"",
          "pauseAfterMs": 5000,
          "textKey": "episode_14.ep14_A02.event4.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Neden?\"",
          "pauseAfterMs": 3500,
          "textKey": "episode_14.ep14_A02.event6.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 4000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Frekansı kesersen onların sesini duymazsın. Onların sesi olmayan yerde — yalnızca onlar kalır. Ve sen olmayacaksın.\"",
          "pauseAfterMs": 5500,
          "textKey": "episode_14.ep14_A02.event8.text"
        },
        {
          "type": "statChange",
          "changes": {
            "fear": 10,
            "memory": [
              "ep14_432hz_kesme_uyari_gunes"
            ]
