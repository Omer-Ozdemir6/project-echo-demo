          "type": "typing",
          "speaker": "JONES",
          "duration": 2000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Alışkanlık.\"",
          "pauseAfterMs": 5000,
          "textKey": "episode_14.ep14_n06_besinci.event18.text"
