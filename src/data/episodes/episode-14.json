          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Dördüncü kattaki turuncu ışık yavaşça söndü. Değil — azaldı. Hâlâ var ama artık ısıtmıyor.",
          "pauseAfterMs": 4000,
          "textKey": "episode_14.ep14_n05_inis.event4.text"
