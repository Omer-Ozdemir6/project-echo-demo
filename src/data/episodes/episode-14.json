          "speaker": "JONES",
          "duration": 4000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Güneş cevaplamadı hemen. \"Onlar\" dedi. Başka bir şey söylemedi.",
          "pauseAfterMs": 4500,
          "textKey": "episode_14.ep14_A01.event4.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3200
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Ve?\" dedim.",
