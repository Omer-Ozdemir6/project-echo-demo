          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Güneş basamakların başında duruyor. Yüzüne bakıyorum. Korkmuyor. Bu iyi değil. Korkan biri, korktuğu şeyi en az biraz tanımıyordur.",
          "pauseAfterMs": 5000,
          "textKey": "episode_14.ep14_n01.event6.text"
        },
        {
          "type": "statChange",
          "changes": {
            "fear": 10,
            "curiosity": 10
          },
          "pauseAfterMs": 100
        }
      ],
      "choices": [
        {
          "id": "c1_sor",
          "text": "\"Girmeden önce bilmem gereken şeyler var.\"",
          "nextNodeId": "ep14_A01",
          "effects": {
