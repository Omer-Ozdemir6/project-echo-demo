    "ep14_A01": {
      "id": "ep14_A01",
      "speaker": "JONES",
      "events": [
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Beşinci katta ne var?\"",
          "pauseAfterMs": 3500,
          "textKey": "episode_14.ep14_A01.event1.text"
        },
        {
          "type": "realTimeWait",
