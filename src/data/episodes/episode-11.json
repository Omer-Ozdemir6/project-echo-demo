        { "type": "typing", "speaker": "JONES", "duration": 4000 },
        { "type": "message", "speaker": "JONES", "text": "Sayfa dolusu not. Metodiktim. Harika. Sonra okudum.", "pauseAfterMs": 3500 },
        { "type": "realTimeWait", "seconds": 5 },
        { "type": "typing", "speaker": "JONES", "duration": 4000 },
