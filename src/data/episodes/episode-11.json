        { "type": "realTimeWait", "seconds": 6 },
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Ya da koydum ve hatırlamıyorum.", "pauseAfterMs": 5000 },
