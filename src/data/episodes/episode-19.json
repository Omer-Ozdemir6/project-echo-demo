        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Selin baktı. Durdurmadı.", "pauseAfterMs": 3500 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Girişe doğru yürüdüm. İçeriye döndüm. Yeniden.", "pauseAfterMs": 4000 },
