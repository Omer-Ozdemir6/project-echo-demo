        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Sekiz yıl boyunca Emre 'git' dediğinde gitmedim. Şimdi de gitmeyeceğim.", "pauseAfterMs": 4500 },
