          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Selin geldi. Emre'ye baktı. Emre'ye değil tam olarak — Emre'nin halime.",
          "pauseAfterMs": 4500,
          "textKey": "episode_19.ep19_n08_sozlesme.event1.text"
