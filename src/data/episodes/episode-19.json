        {
          "type": "typing",
          "speaker": "SELİN",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "SELİN",
          "text": "Söylememek.",
          "pauseAfterMs": 4000,
          "textKey": "episode_19.ep19_n08_sozlesme.event3.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Ne?\"",
          "pauseAfterMs": 3000,
          "textKey": "episode_19.ep19_n08_sozlesme.event5.text"
        },
        {
          "type": "typing",
          "speaker": "SELİN",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "SELİN",
          "text": "Kimseye söylememek. Bu... bu söylenemez.",
          "pauseAfterMs": 5000,
          "textKey": "episode_19.ep19_n08_sozlesme.event7.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 6
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Emre'ye baktım. Emre başını salladı. Az ama salladı.",
          "pauseAfterMs": 4500,
          "textKey": "episode_19.ep19_n08_sozlesme.event10.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Tamam\" dedim.",
          "pauseAfterMs": 5000,
          "textKey": "episode_19.ep19_n08_sozlesme.event12.text"
        },
        {
          "type": "statChange",
          "changes": {
            "selinTrust": 5,
            "humanity": 10
