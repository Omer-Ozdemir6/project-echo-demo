          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Emre 'git' dedi. Ben dinlemedim.",
          "pauseAfterMs": 4000,
          "textKey": "episode_19.ep19_n01.event3.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 5
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Sekiz yıl boyunca Emre 'git' dediğinde gitmedim. Şimdi de gitmeyeceğim.",
          "pauseAfterMs": 4500,
          "textKey": "episode_19.ep19_n01.event6.text"
        },
        {
          "type": "statChange",
          "changes": {
            "emreBaglantisi": 10
          },
