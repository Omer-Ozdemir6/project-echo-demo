    },
    "ep19_n02_inis": {
      "id": "ep19_n02_inis",
      "speaker": "JONES",
      "events": [
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Selin baktı. Durdurmadı.",
          "pauseAfterMs": 3500,
          "textKey": "episode_19.ep19_n02_inis.event1.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Girişe doğru yürüdüm. İçeriye döndüm. Yeniden.",
          "pauseAfterMs": 4000,
          "textKey": "episode_19.ep19_n02_inis.event3.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 6
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Bu sefer farklı. Biliyorum ne var içeride. Biliyorum nereye gideceğimi. Biliyorum Emre'nin nerede olduğunu.",
          "pauseAfterMs": 5000,
          "textKey": "episode_19.ep19_n02_inis.event6.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Iniyorum.",
          "pauseAfterMs": 4000,
          "textKey": "episode_19.ep19_n02_inis.event8.text"
        }
      ],
      "nextNodeId": "ep19_n03_bulur"
    },
    "ep19_n03_bulur": {
      "id": "ep19_n03_bulur",
      "speaker": "JONES",
      "events": [
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Dördüncü kat. Toplantı salonu. Emre burada.",
          "pauseAfterMs": 4000,
          "textKey": "episode_19.ep19_n03_bulur.event1.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 8
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Emre.\"",
          "pauseAfterMs": 4000,
          "textKey": "episode_19.ep19_n03_bulur.event4.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 8
        },
