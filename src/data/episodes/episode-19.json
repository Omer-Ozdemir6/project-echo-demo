      "events": [
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Emre uzun süre baktı. Göz kırpmadan — bu hâlâ böyle.", "pauseAfterMs": 4000 },
        { "type": "realTimeWait", "seconds": 10 },
        { "type": "typing", "speaker": "EMRE", "duration": 4000 },
        { "type": "message", "speaker": "EMRE", "text": "Çıkmak... zor olacak. Benim için.", "pauseAfterMs": 5000 },
