          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "EMRE",
          "text": "Kahve.",
          "pauseAfterMs": 5000,
          "textKey": "episode_19.ep19_son.event5.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 5
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Biliyorum.\"",
          "pauseAfterMs": 4000,
          "textKey": "episode_19.ep19_son.event8.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 6
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Emre hâlâ Emre. Farklı. Ama hâlâ Emre.",
          "pauseAfterMs": 5000,
          "textKey": "episode_19.ep19_son.event11.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 6
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Ve kahveyi nasıl yaptığını öğreteceğim. Ya da o bana öğretecek. Yıllar boyunca öğrenmediğime göre öğretmesi daha iyi.",
          "pauseAfterMs": 6000,
          "textKey": "episode_19.ep19_son.event14.text"
