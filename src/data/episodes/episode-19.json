    "ep19_n04_karar": {
      "id": "ep19_n04_karar",
      "speaker": "JONES",
      "events": [
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Emre uzun süre baktı. Göz kırpmadan — bu hâlâ böyle.",
          "pauseAfterMs": 4000,
          "textKey": "episode_19.ep19_n04_karar.event1.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 10
        },
        {
          "type": "typing",
          "speaker": "EMRE",
          "duration": 4000
        },
        {
          "type": "message",
          "speaker": "EMRE",
          "text": "Çıkmak... zor olacak. Benim için.",
          "pauseAfterMs": 5000,
          "textKey": "episode_19.ep19_n04_karar.event4.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Biliyorum.\"",
          "pauseAfterMs": 3500,
          "textKey": "episode_19.ep19_n04_karar.event6.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Yine de.\"",
          "pauseAfterMs": 5000,
          "textKey": "episode_19.ep19_n04_karar.event8.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 8
        },
        {
          "type": "typing",
          "speaker": "EMRE",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "EMRE",
          "text": "Tamam.",
          "pauseAfterMs": 6000,
          "textKey": "episode_19.ep19_n04_karar.event11.text"
        },
        {
          "type": "statChange",
          "changes": {
            "emreBaglantisi": 10,
            "humanity": 10
          },
          "pauseAfterMs": 100
        }
      ],
      "nextNodeId": "ep19_n05_yukari"
    },
    "ep19_n05_yukari": {
      "id": "ep19_n05_yukari",
      "speaker": "JONES",
      "events": [
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Birlikte yukarı çıktık. Yavaş. Emre her basamakta durdu.",
          "pauseAfterMs": 4000,
          "textKey": "episode_19.ep19_n05_yukari.event1.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Sormadım neden. Anladım.",
          "pauseAfterMs": 4000,
          "textKey": "episode_19.ep19_n05_yukari.event3.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 6
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 4000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Emre bir şeyler bırakıyordu. Her adımda. Ben göremiyordum ama bırakıyordu.",
          "pauseAfterMs": 5000,
          "textKey": "episode_19.ep19_n05_yukari.event6.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Konuşmadık. Bu iyi. Bazen konuşmamak daha dürüst.",
          "pauseAfterMs": 4500,
          "textKey": "episode_19.ep19_n05_yukari.event8.text"
        },
        {
          "type": "statChange",
          "changes": {
            "humanity": 12
          },
          "pauseAfterMs": 100
        }
      ],
      "nextNodeId": "ep19_n06_gunes_isigi"
    },
    "ep19_n06_gunes_isigi": {
      "id": "ep19_n06_gunes_isigi",
      "speaker": "JONES",
      "events": [
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Giriş geçidi. Son basamak.",
          "pauseAfterMs": 3500,
          "textKey": "episode_19.ep19_n06_gunes_isigi.event1.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Emre durdu. Işık görünüyordu ama içeri girmemişti henüz.",
          "pauseAfterMs": 4000,
          "textKey": "episode_19.ep19_n06_gunes_isigi.event3.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 8
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Adım attı.",
          "pauseAfterMs": 4000,
          "textKey": "episode_19.ep19_n06_gunes_isigi.event6.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 10
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Gözlerini kapattı. Güneş yüzüne vurdu.",
          "pauseAfterMs": 4500,
          "textKey": "episode_19.ep19_n06_gunes_isigi.event9.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 10
        },
        {
          "type": "typing",
          "speaker": "EMRE",
          "duration": 2500
        },
        {
          "type": "message",
          "speaker": "EMRE",
          "text": "Güneş.",
          "pauseAfterMs": 5000,
          "textKey": "episode_19.ep19_n06_gunes_isigi.event12.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 6
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 4000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Sadece bu. 'Güneş.' Emre'nin hafızasında gerçek güneş kalmış.",
          "pauseAfterMs": 5000,
          "textKey": "episode_19.ep19_n06_gunes_isigi.event15.text"
        },
        {
          "type": "statChange",
          "changes": {
            "emreBaglantisi": 15,
            "humanity": 20
          },
          "pauseAfterMs": 100
        }
      ],
