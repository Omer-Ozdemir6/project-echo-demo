    },
    "ep19_n07_kamera": {
      "id": "ep19_n07_kamera",
      "speaker": "JONES",
      "events": [
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Kamerayı çıkardım. Vizörden baktım.",
          "pauseAfterMs": 3500,
          "textKey": "episode_19.ep19_n07_kamera.event1.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Emre. Güneş ışığında. Gözleri kapalı. Yüzü yukarıya dönük.",
          "pauseAfterMs": 4500,
          "textKey": "episode_19.ep19_n07_kamera.event3.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Deklanşöre bastım.",
          "pauseAfterMs": 3500,
          "textKey": "episode_19.ep19_n07_kamera.event5.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 4
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Boş. Kamera hâlâ kırık.",
          "pauseAfterMs": 3500,
          "textKey": "episode_19.ep19_n07_kamera.event8.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 5
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Ama bu fotoğraf aklımda. Güneş ışığında Emre. Gözleri kapalı. Bu kez kırık kameranın suçu değil.",
          "pauseAfterMs": 5500,
          "textKey": "episode_19.ep19_n07_kamera.event11.text"
        },
        {
          "type": "statChange",
          "changes": {
            "humanity": 20
          },
          "pauseAfterMs": 100
        }
