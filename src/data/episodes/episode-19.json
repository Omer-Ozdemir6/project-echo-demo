          "type": "typing",
          "speaker": "EMRE",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "EMRE",
          "text": "Gitmedin.",
          "pauseAfterMs": 5000,
          "textKey": "episode_19.ep19_n03_bulur.event7.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 2500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Hayır.\"",
          "pauseAfterMs": 4000,
          "textKey": "episode_19.ep19_n03_bulur.event9.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 8
        },
        {
          "type": "typing",
          "speaker": "EMRE",
          "duration": 4000
        },
        {
          "type": "message",
          "speaker": "EMRE",
          "text": "Neden?",
          "pauseAfterMs": 5000,
          "textKey": "episode_19.ep19_n03_bulur.event12.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Çünkü kahve sözü var ortada.\"",
          "pauseAfterMs": 6000,
          "textKey": "episode_19.ep19_n03_bulur.event14.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 8
        },
        {
          "type": "statChange",
          "changes": {
            "emreBaglantisi": 15,
            "humanity": 15
          },
          "pauseAfterMs": 100
        }
      ],
      "nextNodeId": "ep19_n04_karar"
