    "ep13_B01": {
      "id": "ep13_B01",
      "speaker": "JONES",
      "events": [
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Koridorda ayak izleri. Birden fazla. Toz kalın, izler net.", "pauseAfterMs": 3500 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Diz çöktüm. Parmağımı bastırıyorum. Hangisi benim? Emin olamıyorum.", "pauseAfterMs": 4000 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Boyutlar aynı. Basış açısı aynı. Ama birden fazla set var. Farklı zamanlarda atılmış — kimi üstüne binmiş, kimi solmuş.", "pauseAfterMs": 4500 },
        { "type": "statChange", "changes": { "curiosity": 15, "fear": 8, "mentalStability": -5 }, "pauseAfterMs": 100 }
      ],
      "nextNodeId": "ep13_B02"
    },

    "ep13_B02": {
