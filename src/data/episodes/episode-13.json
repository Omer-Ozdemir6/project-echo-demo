        { "type": "typing", "speaker": "JONES", "duration": 3200 },
        { "type": "message", "speaker": "JONES", "text": "Çantamı kontrol ettim. Su şişesi dolu. Enerji barları tam. EP10'da iki günlük kalmıştı.", "pauseAfterMs": 4000 },
