    "ep13_A01": {
      "id": "ep13_A01",
      "speaker": "JONES",
      "events": [
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Kartlara dokunmadan inceliyorum. EP12'de son hamleyi bırakacak olan kaybediyordu.", "pauseAfterMs": 4000 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Şimdi iki hamle ileri gidilmiş. Biri oynamış. Ben mi oynadım? Bilmiyorum.", "pauseAfterMs": 4500 },
        { "type": "realTimeWait", "seconds": 6 },
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Ya da zamanın ilerlemesi farklı burada. Ya da ben zamanı farklı yaşıyorum.", "pauseAfterMs": 4500 },
        { "type": "statChange", "changes": { "mentalStability": -5, "curiosity": 10 }, "pauseAfterMs": 100 }
      ],
      "nextNodeId": "ep13_A02"
    },

    "ep13_A02": {
      "id": "ep13_A02",
      "speaker": "JONES",
      "events": [
        { "type": "typing", "speaker": "JONES", "duration": 2800 },
        { "type": "message", "speaker": "JONES", "text": "Kapıda bir ses. Emre.", "pauseAfterMs": 3500 },
