        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "EP12'de bıraktığım notu hâlâ elimde tutuyorum.", "pauseAfterMs": 4000 },
        { "type": "realTimeWait", "seconds": 5 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Oda aynı. Sandalyeler aynı. Ama kartlar farklı dizili. Biraz. Az. Fark etmeyecek kadar az.", "pauseAfterMs": 4500 },
