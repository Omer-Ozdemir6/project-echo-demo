      "speaker": "JONES",
      "events": [
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "İzleri takip ettim. Koridorun ucuna kadar. Orada iz devam ediyor.", "pauseAfterMs": 4000 },
        { "type": "realTimeWait", "seconds": 6 },
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
