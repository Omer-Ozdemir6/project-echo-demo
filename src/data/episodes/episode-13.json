        { "type": "message", "speaker": "JONES", "text": "\"Emre?\"", "pauseAfterMs": 3000 },
        { "type": "realTimeWait", "seconds": 5 },
        { "type": "typing", "speaker": "EMRE", "duration": 2500 },
        { "type": "message", "speaker": "EMRE", "text": "Ne diyordum?", "pauseAfterMs": 4000 },
        { "type": "realTimeWait", "seconds": 4 },
        { "type": "typing", "speaker": "EMRE", "duration": 2000 },
        { "type": "message", "speaker": "EMRE", "text": "Ben mi sordum?", "pauseAfterMs": 5000 },
        { "type": "typing", "speaker": "JONES", "duration": 4000 },
        { "type": "message", "speaker": "JONES", "text": "Emre cümle kurarken özne değişti. 'Ben' 'o' oldu sonra 'ben'e döndü. Ve artık ne sorduğunu bilmiyor.", "pauseAfterMs": 5000 },
        { "type": "statChange", "changes": { "emreDeğişim": 3, "fear": 15, "emreBaglantisi": -5 }, "pauseAfterMs": 100 }
