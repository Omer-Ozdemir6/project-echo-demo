        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Selin kalktı. Yaklaşıyor.", "pauseAfterMs": 3500 },
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
