        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Rüzgar var. Ağaç sesi. Kuş sesi. Bunların hepsini unuttum.", "pauseAfterMs": 4500 },
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Kaç gün geçti? Sakalıma baktım. On gün belki. Belki on iki.", "pauseAfterMs": 4500 },
