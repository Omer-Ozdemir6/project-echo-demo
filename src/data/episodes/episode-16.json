        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Gölgeme baktım. Günler sonra ilk kez.", "pauseAfterMs": 4000 },
        { "type": "realTimeWait", "seconds": 6 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Normal. Beni takip ediyor. Soluma uzanıyor çünkü güneş sağımda.", "pauseAfterMs": 4000 },
        { "type": "realTimeWait", "seconds": 5 },
        { "type": "typing", "speaker": "JONES", "duration": 4000 },
        { "type": "message", "speaker": "JONES", "text": "Her şey aynı. Güneş aynı. Taş aynı. Toprak aynı. Ben farklıyım. Ama gölge bilmiyor bunu.", "pauseAfterMs": 5000 },
        { "type": "statChange", "changes": { "humanity": 10, "curiosity": 5 } }
      ],
      "nextNodeId": "ep16_n04_selin_once"
    },

    "ep16_n04_selin_once": {
      "id": "ep16_n04_selin_once",
      "speaker": "JONES",
      "events": [
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Selin. Onlarca metre ötede, kamp alanında oturuyor. Beklemiş.", "pauseAfterMs": 4000 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Kalkmıyor. Gördü beni ama kalkmıyor. Bekliyor.", "pauseAfterMs": 4000 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Yalnız döndüğümü gördü. Emre yok. Bu kadar yeterli.", "pauseAfterMs": 4500 },
        { "type": "statChange", "changes": { "fear": 5 } }
      ],
      "choices": [
        { "id": "c1_soyle", "text": "Git ve her şeyi söyle. Hazırsan hazırsın.", "nextNodeId": "ep16_A01", "effects": { "trust": 8, "onlarFarkındalığı": 5 } },
        { "id": "c1_bekle", "text": "Dur. Ne söyleyeceğini önce planla.",          "nextNodeId": "ep16_B01", "effects": { "mentalStability": 5, "humanity": 5 } }
      ]
    },

    "ep16_A01": {
      "id": "ep16_A01",
      "speaker": "JONES",
      "events": [
        { "type": "typing", "speaker": "JONES", "duration": 2800 },
        { "type": "message", "speaker": "JONES", "text": "Selin'e doğru yürüdüm. Düz, duraksamamadan.", "pauseAfterMs": 3500 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Selin kalktı. Yüzüne baktım. Günler geçmiş onda da. Uyumamış.", "pauseAfterMs": 4000 },
        { "type": "statChange", "changes": { "humanity": 5 } }
      ],
      "choices": [
        { "id": "c_a01_soyle", "text": "Söyle. Doğrudan.", "nextNodeId": "ep16_A01_b", "effects": { "trust": 5 } },
        { "id": "c_a01_bekle", "text": "Önce Selin'i dinle.",  "nextNodeId": "ep16_A01_b", "effects": { "selinTrust": 5 } }
      ]
    },

    "ep16_A01_b": {
      "id": "ep16_A01_b",
      "speaker": "JONES",
      "events": [
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "\"Anlatacağım\" dedim. \"Her şeyi. Ama söylediğim her şeyin doğru olduğundan emin olamam.\"", "pauseAfterMs": 5000 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Selin baktı. \"Biliyorum\" dedi. \"Ben de.\"", "pauseAfterMs": 4500 },
        { "type": "statChange", "changes": { "selinTrust": 10, "trust": 5 } }
      ],
      "nextNodeId": "ep16_A02"
    },

    "ep16_A02": {
      "id": "ep16_A02",
      "speaker": "JONES",
      "events": [
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "\"Babandan biliyordun. Bir kısmını. ONLAR'dan geçerek.\"", "pauseAfterMs": 4000 },
        { "type": "realTimeWait", "seconds": 8 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Selin sustu. Uzun. \"Güneş bunu sana söyledi.\"", "pauseAfterMs": 4000 },
        { "type": "typing", "speaker": "JONES", "duration": 2800 },
        { "type": "message", "speaker": "JONES", "text": "\"Evet.\"", "pauseAfterMs": 3500 },
        { "type": "statChange", "changes": { "selinTrust": 5 } }
      ],
      "choices": [
        { "id": "c_a02_devam", "text": "Devam et. Bilmesi gerek.",      "nextNodeId": "ep16_A02_b", "effects": { "trust": 5 } },
        { "id": "c_a02_bak",   "text": "Dur. Selin'in yüzüne bak.",    "nextNodeId": "ep16_A02_b", "effects": { "humanity": 5 } }
      ]
