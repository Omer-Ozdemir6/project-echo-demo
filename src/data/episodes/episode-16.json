        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Selin sustu. Uzun. \"Güneş bunu sana söyledi.\"", "pauseAfterMs": 4000 },
        { "type": "typing", "speaker": "JONES", "duration": 2800 },
        { "type": "message", "speaker": "JONES", "text": "\"Evet.\"", "pauseAfterMs": 3500 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "\"Güneş hâlâ...\" başladı Selin.", "pauseAfterMs": 3000 },
        { "type": "typing", "speaker": "JONES", "duration": 2500 },
        { "type": "message", "speaker": "JONES", "text": "\"Evet.\"", "pauseAfterMs": 4000 },
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "\"Ve Emre.\"", "pauseAfterMs": 3500 },
        { "type": "typing", "speaker": "JONES", "duration": 2500 },
        { "type": "message", "speaker": "JONES", "text": "\"Evet.\"", "pauseAfterMs": 5000 },
        { "type": "statChange", "changes": { "selinTrust": 8, "humanity": 10 }, "pauseAfterMs": 100 }
      ],
      "nextNodeId": "ep16_A03"
