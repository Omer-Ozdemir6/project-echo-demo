        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Selin'in yüzü geçti. Bir şey. Küçük.", "pauseAfterMs": 4000 },
        { "type": "statChange", "changes": { "selinTrust": 3, "humanity": 12 }, "pauseAfterMs": 100 }
