        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Selin oturdu. Yere. Beklenmedik bir şekilde.", "pauseAfterMs": 3500 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "\"Babam döndüğünde ben on ikiyidim\" dedi. \"Ve o gece yemek masasında bana baktı. Sonra başka tarafa döndü. Bir daha hiç doğrudan bakmadı.\"", "pauseAfterMs": 6000 },
        { "type": "realTimeWait", "seconds": 6 },
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "\"Emre de mi?\" dedi.", "pauseAfterMs": 4000 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Cevap vermedim. Selin zaten biliyordu.", "pauseAfterMs": 4500 },
        { "type": "statChange", "changes": { "selinTrust": 10, "humanity": 15, "emreBaglantisi": -3 }, "pauseAfterMs": 100 }
      ],
      "nextNodeId": "ep16_n08_nerede"
