    "ep16_B01": {
      "id": "ep16_B01",
      "speaker": "JONES",
      "events": [
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Durdum. Selin beni görüyor ama yaklaşmıyorum henüz.", "pauseAfterMs": 3500 },
        { "type": "typing", "speaker": "JONES", "duration": 4000 },
        { "type": "message", "speaker": "JONES", "text": "Ne söyleyebilirim? 'Emre aşağıda' — bu doğru ama eksik. 'Kendi seçimiyle' — bu da doğru ama anlaşılmaz.", "pauseAfterMs": 5000 },
        { "type": "statChange", "changes": { "mentalStability": 3 } }
