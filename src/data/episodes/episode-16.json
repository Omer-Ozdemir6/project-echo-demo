        { "type": "message", "speaker": "JONES", "text": "Selin oturdu. Yere. Beklenmedik bir şekilde.", "pauseAfterMs": 3500 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "\"Babam döndüğünde ben on ikiyidim\" dedi. \"Ve o gece yemek masasında bana baktı. Sonra başka tarafa döndü. Bir daha hiç doğrudan bakmadı.\"", "pauseAfterMs": 6000 },
