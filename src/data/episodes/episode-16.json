      "events": [
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "\"Güneş hâlâ...\" başladı Selin.", "pauseAfterMs": 3000 },
        { "type": "typing", "speaker": "JONES", "duration": 2500 },
        { "type": "message", "speaker": "JONES", "text": "\"Evet.\"", "pauseAfterMs": 4000 },
        { "type": "statChange", "changes": { "selinTrust": 5 } }
      ],
      "choices": [
        { "id": "c_a02b_emre",  "text": "'Ve Emre.' — Selin söyledi. Bekliyorsun.", "nextNodeId": "ep16_A02_c", "effects": { "emreBaglantisi": 3 } },
        { "id": "c_a02b_soyle", "text": "Kendisi söyledi. Sen de söyle: 'Ve Emre.'", "nextNodeId": "ep16_A02_c", "effects": { "trust": 5 } }
      ]
    },

    "ep16_A02_c": {
      "id": "ep16_A02_c",
