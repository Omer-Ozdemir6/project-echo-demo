      "events": [
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Durdum. Selin beni görüyor ama yaklaşmıyorum henüz.", "pauseAfterMs": 3500 },
        { "type": "typing", "speaker": "JONES", "duration": 4000 },
        { "type": "message", "speaker": "JONES", "text": "Ne söyleyebilirim? 'Emre aşağıda' — bu doğru ama eksik. 'Kendi seçimiyle' — bu da doğru ama anlaşılmaz.", "pauseAfterMs": 5000 },
        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "'ONLAR var ve Emre onlarla bağlantı kurdu' — buna kim inanır?", "pauseAfterMs": 4500 },
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "Ben inanırdım. Selin inanır. Başkası bilmiyorum.", "pauseAfterMs": 4500 },
        { "type": "statChange", "changes": { "mentalStability": 3, "curiosity": 5 }, "pauseAfterMs": 100 }
      ],
      "nextNodeId": "ep16_B02"
    },

    "ep16_B02": {
