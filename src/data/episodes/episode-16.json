      ],
      "choices": [
        { "id": "c_a03_sessiz",  "text": "Sessizle. Selin konuşsun.",       "nextNodeId": "ep16_A03_b", "effects": { "selinTrust": 5 } },
        { "id": "c_a03_emre_mi", "text": "'Emre de mi?' sorusunu bekle.",  "nextNodeId": "ep16_A03_b", "effects": { "humanity": 5 } }
      ]
    },

    "ep16_A03_b": {
      "id": "ep16_A03_b",
      "speaker": "JONES",
      "events": [
