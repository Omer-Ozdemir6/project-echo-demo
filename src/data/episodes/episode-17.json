  "nodes": {
    "ep17_n01": {
      "id": "ep17_n01",
      "speaker": "JONES",
      "events": [
        {
          "type": "systemAlert",
          "text": "KATMAN KÖPRÜSÜ: YÜZEY — SABAH — TELSİZ AKTİF",
