        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Babamın\" dedi. \"1987 sonrası yazdı. Ben okumadım. Sana veriyorum. Belki bir işine yarar.\"",
          "pauseAfterMs": 5000
        },
        {
          "type": "statChange",
          "changes": {
            "curiosity": 5
          }
        }
      ],
      "choices": [
        {
          "id": "c_a03_sor",
