        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 2800
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Beni beklemiş.",
          "pauseAfterMs": 4000
        },
        {
          "type": "statChange",
          "changes": {
            "humanity": 5
          }
        }
      ],
      "choices": [
        {
          "id": "c_a01_otur",
          "text": "Otur. Çayı al. Sadece bu an.",
          "nextNodeId": "ep17_A01_b",
          "effects": {
            "humanity": 5
          }
        },
        {
          "id": "c_a01_bak",
          "text": "Selin'e bak. Ne hissediyor?",
          "nextNodeId": "ep17_A01_b",
          "effects": {
            "selinTrust": 5
          }
        }
      ]
    },
    "ep17_A01_b": {
      "id": "ep17_A01_b",
      "speaker": "JONES",
      "events": [
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Oturdum. Çayı aldım. \"Teşekkürler\" dedim.",
          "pauseAfterMs": 3500
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Emre nasıl yapardı?\" dedi.",
          "pauseAfterMs": 3500
