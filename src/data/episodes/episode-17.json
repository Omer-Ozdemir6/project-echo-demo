        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Kayalığa oturdum. Güneş doğuyor. Bu kez gerçek güneş.",
