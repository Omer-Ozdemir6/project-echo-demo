{
  "id": "episode_17",
  "episode": 17,
  "title": "Sabah",
  "startNodeId": "ep17_n01",
  "episodeObjective": "Karar ver.",
  "nodes": {
    "ep17_n01": {
      "id": "ep17_n01",
      "speaker": "SİSTEM",
      "events": [
        {
          "type": "systemAlert",
          "text": "KATMAN KÖPRÜSÜ: YÜZEY — SABAH — TELSİZ AKTİF",
          "pauseAfterMs": 2500,
          "textKey": "episode_17.ep17_n01.event0.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 4
        },
        {
          "type": "relationshipDialogue",
          "conditions": {
            "trust": {
              "gte": 60
            }
          },
          "trueText": "Sabah. İlk defa burada uyudum. Rüya görmedim.",
          "falseText": "Sabah olmuş."
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Emre bana bir kez 'seni gömmüşler yorgunken bile uyuyamazsın' demişti. Haklıydı. Dün gece de uyuyamadım.",
          "pauseAfterMs": 5000,
          "textKey": "episode_17.ep17_n01.event4.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 5
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Ama sabah oldu. Bu yeterli.",
          "pauseAfterMs": 4000,
          "textKey": "episode_17.ep17_n01.event7.text"
        },
        {
          "type": "statChange",
          "changes": {
            "humanity": 8
          },
          "pauseAfterMs": 100
        }
      ],
      "nextNodeId": "ep17_n02_cay"
    },
    "ep17_n02_cay": {
      "id": "ep17_n02_cay",
      "speaker": "JONES",
      "events": [
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Kamp ocağını bulmaya çalıştım. Selin'in ekipmanlarında bir şeyler var.",
          "pauseAfterMs": 3500,
          "textKey": "episode_17.ep17_n02_cay.event1.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Emre'nin termosu nasıl çalışıyordu? Bunu biliyorum. Bunu öğrendim. Ama şimdi unutmuşum.",
          "pauseAfterMs": 4000,
          "textKey": "episode_17.ep17_n02_cay.event3.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 5
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Bu yerin değil — bu benim normalim. On yıldır çay yapmasını öğrenemedim.",
          "pauseAfterMs": 4500,
          "textKey": "episode_17.ep17_n02_cay.event6.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Emre her zaman yapar, ben içerdim.",
          "pauseAfterMs": 5000,
          "textKey": "episode_17.ep17_n02_cay.event8.text"
        },
        {
          "type": "statChange",
          "changes": {
            "humanity": 12,
            "emreBaglantisi": 3
          },
          "pauseAfterMs": 100
        }
      ],
      "choices": [
        {
          "id": "c1_selin",
          "text": "Selin'in yanına git. Konuşmak gerekiyor.",
          "nextNodeId": "ep17_A01",
          "effects": {
            "selinTrust": 5,
            "trust": 5
          },
          "textKey": "episode_17.ep17_n02_cay.choice0.text"
        },
        {
          "id": "c1_yalniz",
          "text": "Biraz daha yalnız kal. Hazır değilsin henüz.",
          "nextNodeId": "ep17_B01",
          "effects": {
            "mentalStability": 5,
            "humanity": 5
          },
          "textKey": "episode_17.ep17_n02_cay.choice1.text"
        }
      ]
    },
    "ep17_A01": {
      "id": "ep17_A01",
      "speaker": "JONES",
      "events": [
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Selin ateşin başında oturuyordu. Çay yapmış. İkiye koymuş.",
          "pauseAfterMs": 3500,
          "textKey": "episode_17.ep17_A01.event1.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 2800
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Beni beklemiş.",
          "pauseAfterMs": 4000,
          "textKey": "episode_17.ep17_A01.event3.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Oturdum. Çayı aldım. \"Teşekkürler\" dedim.",
          "pauseAfterMs": 3500,
          "textKey": "episode_17.ep17_A01.event5.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Emre nasıl yapardı?\" dedi.",
          "pauseAfterMs": 3500,
          "textKey": "episode_17.ep17_A01.event7.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Bilmiyorum\" dedim. \"Hiç sormadım.\"",
          "pauseAfterMs": 5000,
          "textKey": "episode_17.ep17_A01.event9.text"
        },
        {
          "type": "statChange",
          "changes": {
            "humanity": 10
          },
          "pauseAfterMs": 100
        }
      ],
      "nextNodeId": "ep17_A02"
    },
    "ep17_A02": {
      "id": "ep17_A02",
      "speaker": "SELİN",
      "events": [
        {
          "type": "realTimeWait",
          "seconds": 6
        },
        {
          "type": "typing",
          "speaker": "SELİN",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "SELİN",
          "text": "Ne yapacaksın?",
          "pauseAfterMs": 5000,
          "textKey": "episode_17.ep17_A02.event2.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 10
        },
        {
          "type": "relationshipDialogue",
          "conditions": {
            "emreBaglantisi": {
              "gte": 50
            }
          },
          "trueText": "\"Henüz bilmiyorum\" dedim. Bu doğruydu ve yalansa.",
          "falseText": "Cevap vermedim. Çayı içtim."
        },
        {
          "type": "realTimeWait",
          "seconds": 6
        },
        {
          "type": "typing",
          "speaker": "SELİN",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "SELİN",
          "text": "\"Tamam\" dedi. Başka bir şey sormadı.",
          "pauseAfterMs": 4500,
          "textKey": "episode_17.ep17_A02.event7.text"
        },
        {
          "type": "statChange",
          "changes": {
            "selinTrust": 8
          },
          "pauseAfterMs": 100
        }
      ],
      "nextNodeId": "ep17_A03"
    },
    "ep17_A03": {
      "id": "ep17_A03",
      "speaker": "JONES",
      "events": [
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Selin cebinden küçük bir defter çıkardı. Eski, yıpranmış.",
          "pauseAfterMs": 3500,
          "textKey": "episode_17.ep17_A03.event1.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Babamın\" dedi. \"1987 sonrası yazdı. Ben okumadım. Sana veriyorum. Belki bir işine yarar.\"",
          "pauseAfterMs": 5000,
          "textKey": "episode_17.ep17_A03.event3.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Neden okumadın?\"",
          "pauseAfterMs": 3500,
          "textKey": "episode_17.ep17_A03.event5.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 6
        },
        {
          "type": "typing",
          "speaker": "SELİN",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "SELİN",
          "text": "\"Çünkü okusaydım anlardım. Ve anlamak için daha hazır değildim.\"",
          "pauseAfterMs": 5000,
          "textKey": "episode_17.ep17_A03.event8.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Defteri aldım. Selin kalktı, kendi çadırına gitti.",
          "pauseAfterMs": 4000,
          "textKey": "episode_17.ep17_A03.event10.text"
        },
        {
          "type": "statChange",
          "changes": {
            "selinTrust": 10,
            "curiosity": 12,
            "humanity": 10
          },
          "pauseAfterMs": 100
        }
      ],
      "nextNodeId": "ep17_n06_defter"
    },
    "ep17_B01": {
      "id": "ep17_B01",
      "speaker": "JONES",
      "events": [
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Kayalığa oturdum. Güneş doğuyor. Bu kez gerçek güneş.",
          "pauseAfterMs": 4000,
          "textKey": "episode_17.ep17_B01.event1.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 4000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "EP01'den bu yana ne kadar zaman geçti? Hesaplamak istemiyorum. Ama çok.",
          "pauseAfterMs": 4500,
          "textKey": "episode_17.ep17_B01.event3.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 4000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Emre orada. Güneş orada. 1987 ekibinin geri kalanları — bilmiyorum nerede. Ben buradayım.",
          "pauseAfterMs": 4500,
          "textKey": "episode_17.ep17_B01.event5.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 8
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Burada olmak yeterli mi? Hayır. Ama şu an elimdeki bu.",
          "pauseAfterMs": 4500,
          "textKey": "episode_17.ep17_B01.event8.text"
        },
        {
          "type": "statChange",
          "changes": {
            "humanity": 12,
            "mentalStability": 8
          },
          "pauseAfterMs": 100
        }
      ],
      "nextNodeId": "ep17_B02"
    },
    "ep17_B02": {
      "id": "ep17_B02",
      "speaker": "JONES",
      "events": [
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Selin yanıma geldi. Bir şey söylemeden oturdu. İki bardak çay, ikisi de sıcak.",
          "pauseAfterMs": 4000,
          "textKey": "episode_17.ep17_B02.event1.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Birini uzattı. Aldım.",
          "pauseAfterMs": 3500,
          "textKey": "episode_17.ep17_B02.event3.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 8
        },
        {
          "type": "typing",
          "speaker": "SELİN",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "SELİN",
          "text": "\"Babamın defterini sana bırakmak istiyorum. 1987 sonrası yazdı. Okumadım.\"",
          "pauseAfterMs": 5000,
          "textKey": "episode_17.ep17_B02.event6.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Defteri aldım. Elimde tutuyorum ama açmıyorum henüz.",
          "pauseAfterMs": 4000,
          "textKey": "episode_17.ep17_B02.event8.text"
        },
        {
          "type": "statChange",
          "changes": {
            "selinTrust": 8,
            "curiosity": 10,
            "humanity": 8
          },
          "pauseAfterMs": 100
        }
      ],
      "nextNodeId": "ep17_n06_defter"
    },
    "ep17_n06_defter": {
      "id": "ep17_n06_defter",
      "speaker": "JONES",
      "events": [
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Defteri açtım. İlk satır.",
          "pauseAfterMs": 3500,
          "textKey": "episode_17.ep17_n06_defter.event1.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 6
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 4000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "'Bugün döndüm. Yarın ne yapacağımı bilmiyorum.'",
          "pauseAfterMs": 5000,
          "textKey": "episode_17.ep17_n06_defter.event4.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 8
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 4000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Kapatttım. Selin'e baktım. Selin kayaya bakıyordu.",
          "pauseAfterMs": 4000,
          "textKey": "episode_17.ep17_n06_defter.event7.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Dr. Arslan da aynı yerde durmuştu. Aynı soruyla. 1987'de.",
          "pauseAfterMs": 4500,
          "textKey": "episode_17.ep17_n06_defter.event9.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Ben de duruyorum. Aynı yerde.",
          "pauseAfterMs": 5000,
          "textKey": "episode_17.ep17_n06_defter.event11.text"
        },
        {
          "type": "statChange",
          "changes": {
            "humanity": 15,
            "curiosity": 10,
            "memory": [
              "ep17_baban_ayni_yer"
            ]
          },
          "pauseAfterMs": 100
        }
      ],
      "nextNodeId": "ep17_n07_giris"
    },
    "ep17_n07_giris": {
      "id": "ep17_n07_giris",
      "speaker": "JONES",
      "events": [
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Giriş geçidi. Buradan görünüyor. İki yüz metre.",
          "pauseAfterMs": 3500,
          "textKey": "episode_17.ep17_n07_giris.event1.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 8
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Ne olduğunu biliyorum. İçinde ne var. Kim var. Ne yok.",
          "pauseAfterMs": 4000,
          "textKey": "episode_17.ep17_n07_giris.event4.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 6
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "EP01'de o girişe ilk baktığımda hiçbirini bilmiyordum.",
          "pauseAfterMs": 4500,
          "textKey": "episode_17.ep17_n07_giris.event7.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 5
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Şimdi biliyorum. Ve bakıyorum.",
          "pauseAfterMs": 5000,
          "textKey": "episode_17.ep17_n07_giris.event10.text"
        },
        {
          "type": "statChange",
          "changes": {
            "emreBaglantisi": 5,
            "humanity": 10
          },
          "pauseAfterMs": 100
        }
      ],
      "nextNodeId": "ep17_n08_uyari"
    },
    "ep17_n08_uyari": {
      "id": "ep17_n08_uyari",
      "speaker": "SELİN",
      "events": [
        {
          "type": "typing",
          "speaker": "SELİN",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "SELİN",
          "text": "Jones.",
          "pauseAfterMs": 3500,
          "textKey": "episode_17.ep17_n08_uyari.event1.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 2000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Evet.\"",
          "pauseAfterMs": 3000,
          "textKey": "episode_17.ep17_n08_uyari.event3.text"
        },
        {
          "type": "typing",
          "speaker": "SELİN",
          "duration": 4500
        },
        {
          "type": "message",
          "speaker": "SELİN",
          "text": "Ne yaparsan yap — dikkatli düşün. Bu kararı geri alamazsın.",
          "pauseAfterMs": 5000,
          "textKey": "episode_17.ep17_n08_uyari.event5.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 5
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Biliyorum.\"",
          "pauseAfterMs": 3500,
          "textKey": "episode_17.ep17_n08_uyari.event8.text"
        },
        {
          "type": "typing",
          "speaker": "SELİN",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "SELİN",
          "text": "\"Babam da biliyordu. Ve yine de yanlış yaptı.\"",
          "pauseAfterMs": 5000,
          "textKey": "episode_17.ep17_n08_uyari.event10.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 6
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Ne yapmalıydı?\"",
          "pauseAfterMs": 3500,
          "textKey": "episode_17.ep17_n08_uyari.event13.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 8
        },
        {
          "type": "typing",
          "speaker": "SELİN",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "SELİN",
          "text": "\"Anlatmalıydı. Bana. Bir kez.\"",
          "pauseAfterMs": 6000,
          "textKey": "episode_17.ep17_n08_uyari.event16.text"
        },
        {
          "type": "statChange",
          "changes": {
            "selinTrust": 12,
            "humanity": 15,
            "onlarFarkındalığı": 5
          },
          "pauseAfterMs": 100
        }
      ],
      "choices": [
        {
          "id": "c2_hazir",
          "text": "Kalk. Hazırsın.",
          "nextNodeId": "ep17_n09_hareket",
          "effects": {
            "mentalStability": 3
          },
          "textKey": "episode_17.ep17_n08_uyari.choice0.text"
        },
        {
          "id": "c2_dakika",
          "text": "Bir dakika daha. Son bir kez düşün.",
          "nextNodeId": "ep17_n09_bekle",
          "effects": {
            "humanity": 8,
            "trust": 5
          },
          "textKey": "episode_17.ep17_n08_uyari.choice1.text"
        }
      ]
    },
    "ep17_n09_hareket": {
      "id": "ep17_n09_hareket",
      "speaker": "JONES",
      "events": [
        {
