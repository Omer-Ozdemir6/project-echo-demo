        {
          "type": "realTimeWait",
          "seconds": 4
        },
        {
          "type": "relationshipDialogue",
          "conditions": {
            "trust": {
              "gte": 60
            }
          },
          "trueText": "Sabah. İlk defa burada uyudum. Rüya görmedim.",
          "falseText": "Sabah olmuş."
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Emre bana bir kez 'seni gömmüşler yorgunken bile uyuyamazsın' demişti. Haklıydı. Dün gece de uyuyamadım.",
          "pauseAfterMs": 5000
        },
        {
          "type": "realTimeWait",
          "seconds": 5
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Ama sabah oldu. Bu yeterli.",
          "pauseAfterMs": 4000
        },
        {
          "type": "statChange",
          "changes": {
            "humanity": 8
          }
        }
      ],
      "nextNodeId": "ep17_n02_cay"
    },
    "ep17_n02_cay": {
      "id": "ep17_n02_cay",
      "speaker": "JONES",
      "events": [
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Kamp ocağını bulmaya çalıştım. Selin'in ekipmanlarında bir şeyler var.",
          "pauseAfterMs": 3500
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Emre'nin termosu nasıl çalışıyordu? Bunu biliyorum. Bunu öğrendim. Ama şimdi unutmuşum.",
          "pauseAfterMs": 4000
        },
        {
          "type": "realTimeWait",
          "seconds": 5
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Bu yerin değil — bu benim normalim. On yıldır çay yapmasını öğrenemedim.",
          "pauseAfterMs": 4500
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Emre her zaman yapar, ben içerdim.",
          "pauseAfterMs": 5000
        },
        {
          "type": "statChange",
          "changes": {
            "humanity": 12,
            "emreBaglantisi": 3
          }
        }
      ],
      "choices": [
        {
          "id": "c1_selin",
          "text": "Selin'in yanına git. Konuşmak gerekiyor.",
          "nextNodeId": "ep17_A01",
          "effects": {
            "selinTrust": 5,
            "trust": 5
          }
        },
        {
          "id": "c1_yalniz",
          "text": "Biraz daha yalnız kal. Hazır değilsin henüz.",
          "nextNodeId": "ep17_B01",
          "effects": {
            "mentalStability": 5,
            "humanity": 5
          }
        }
      ]
    },
    "ep17_A01": {
      "id": "ep17_A01",
      "speaker": "JONES",
      "events": [
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Selin ateşin başında oturuyordu. Çay yapmış. İkiye koymuş.",
          "pauseAfterMs": 3500
