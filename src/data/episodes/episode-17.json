      "speaker": "SELİN",
      "events": [
        {
          "type": "realTimeWait",
          "seconds": 6
        },
        {
          "type": "typing",
          "speaker": "SELİN",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "SELİN",
          "text": "Ne yapacaksın?",
