        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Bilmiyorum\" dedim. \"Hiç sormadım.\"",
          "pauseAfterMs": 5000
        },
        {
          "type": "statChange",
          "changes": {
            "humanity": 10
          }
        }
      ],
      "nextNodeId": "ep17_A02"
    },
    "ep17_A02": {
