    "ep20_n02_yazar": {
      "id": "ep20_n02_yazar",
      "speaker": "JONES",
      "events": [
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Başlık: Katman. Alt başlık yok. Başlık yeterli.",
          "pauseAfterMs": 4000,
          "textKey": "episode_20.ep20_n02_yazar.event1.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 4000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Her şeyi yazdım. ONLAR'ı, Güneş'i, Emre'yi, 1987'yi, döngüyü, frekansı.",
          "pauseAfterMs": 4500,
          "textKey": "episode_20.ep20_n02_yazar.event3.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 4000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Emre'nin seçimini de yazdım. Sayfanın ortasına, büyük harflerle: EMRE KOÇ KENDİ SEÇİMİYLE İÇERİDE KALDI.",
          "pauseAfterMs": 5000,
          "textKey": "episode_20.ep20_n02_yazar.event5.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 6
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Bu onun hakkı. Ve benim görevim.",
          "pauseAfterMs": 4500,
          "textKey": "episode_20.ep20_n02_yazar.event8.text"
        },
        {
          "type": "statChange",
          "changes": {
            "humanity": 15,
            "onlarFarkındalığı": 5
          },
          "pauseAfterMs": 100
        }
      ],
      "nextNodeId": "ep20_n03_selin"
    },
    "ep20_n03_selin": {
      "id": "ep20_n03_selin",
      "speaker": "JONES",
      "events": [
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Selin'e gösterdim. Okurken yüzü değişmedi.",
          "pauseAfterMs": 3500,
          "textKey": "episode_20.ep20_n03_selin.event1.text"
        },
        {
          "type": "realTimeWait",
