          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Not defterimi açtım. İlk sayfa boş.",
          "pauseAfterMs": 3500,
          "textKey": "episode_20.ep20_n01.event3.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 5
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Fotoğrafçıyım. Normalde görselle anlatırım. Kamera kırık. Kelimelerle anlatmak zorundayım.",
          "pauseAfterMs": 4500,
          "textKey": "episode_20.ep20_n01.event6.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "EP01'den beri zaten böyle yapıyordum. Artık biliyorum nasıl yapılacağını.",
          "pauseAfterMs": 5000,
          "textKey": "episode_20.ep20_n01.event8.text"
        },
        {
          "type": "statChange",
          "changes": {
            "humanity": 10
          },
