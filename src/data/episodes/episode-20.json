          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "SELİN",
          "text": "Babamı yazmışsın.",
          "pauseAfterMs": 4000,
          "textKey": "episode_20.ep20_n03_selin.event4.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 2500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "\"Evet.\"",
          "pauseAfterMs": 3500,
          "textKey": "episode_20.ep20_n03_selin.event6.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 6
        },
        {
          "type": "typing",
          "speaker": "SELİN",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "SELİN",
          "text": "\"İyi.\" dedi. \"Otuz yıldır kimse yazmamıştı.\"",
          "pauseAfterMs": 5000,
          "textKey": "episode_20.ep20_n03_selin.event9.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Selin ağlamadı. Ben de ağlamadım. Bazen bu daha ağır.",
          "pauseAfterMs": 4500,
          "textKey": "episode_20.ep20_n03_selin.event11.text"
        },
        {
          "type": "statChange",
          "changes": {
            "selinTrust": 15,
            "humanity": 12
          },
          "pauseAfterMs": 100
        }
      ],
      "nextNodeId": "ep20_n04_dunya"
    },
    "ep20_n04_dunya": {
      "id": "ep20_n04_dunya",
      "speaker": "JONES",
      "events": [
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Makaleyi yayınladım. Fotoğraf yok — sadece kelimeler. İlk kez.",
          "pauseAfterMs": 4000,
          "textKey": "episode_20.ep20_n04_dunya.event1.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 4000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Dünya tepkisi ikiye bölündü. Yarısı inanmadı. Yarısı inanmak istedi.",
          "pauseAfterMs": 4500,
          "textKey": "episode_20.ep20_n04_dunya.event3.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Beklediğim buydu.",
          "pauseAfterMs": 3500,
          "textKey": "episode_20.ep20_n04_dunya.event5.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 5
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 4000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Ama bazı insanlar girişi aramaya başladı. Bu beklemediğim bir şeydi. Yani aslında beklediğim ama beklememek istediğim.",
          "pauseAfterMs": 5000,
          "textKey": "episode_20.ep20_n04_dunya.event8.text"
        },
        {
          "type": "statChange",
          "changes": {
            "humanity": 8,
            "curiosity": 5
          },
          "pauseAfterMs": 100
        }
      ],
      "nextNodeId": "ep20_n05_giris"
    },
    "ep20_n05_giris": {
      "id": "ep20_n05_giris",
      "speaker": "JONES",
      "events": [
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Girişe döndüm. Kapanmıştı — doğal olarak. Ya da ONLAR kapatmıştı. Fark etmez.",
          "pauseAfterMs": 4500,
          "textKey": "episode_20.ep20_n05_giris.event1.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Kayalığa bir şey bıraktım. Küçük bir not. Bir sonraki Jones için değil bu sefer.",
          "pauseAfterMs": 4500,
          "textKey": "episode_20.ep20_n05_giris.event3.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 6
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Girmeye çalışacak birisi için.",
          "pauseAfterMs": 4000,
          "textKey": "episode_20.ep20_n05_giris.event6.text"
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 4000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Not şunu söylüyordu: 'Gitme. Ama gideceksen — operatörünü yanında tut.'",
          "pauseAfterMs": 5500,
          "textKey": "episode_20.ep20_n05_giris.event8.text"
        },
        {
          "type": "statChange",
          "changes": {
            "humanity": 15
          },
          "pauseAfterMs": 100
        }
      ],
      "nextNodeId": "ep20_n06_son_not"
