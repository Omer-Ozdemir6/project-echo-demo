          "type": "typing",
          "speaker": "JONES",
          "duration": 3000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Boş. Hâlâ kırık.",
          "pauseAfterMs": 3500,
          "textKey": "episode_20.ep20_son.event9.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 5
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 4000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Ama bu fotoğrafı herkes görecek. Çünkü anlattım.",
          "pauseAfterMs": 5500,
          "textKey": "episode_20.ep20_son.event12.text"
        },
        {
