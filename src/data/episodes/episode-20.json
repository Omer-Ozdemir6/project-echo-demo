        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Yazdığımı okumuş. Bir şekilde. Ve cevap yazmış.",
          "pauseAfterMs": 4500,
          "textKey": "episode_20.ep20_n06_son_not.event6.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 6
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 3500
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "'Bu sefer gerçekten.' Demek ki öncekiler gerçek değildi. Demek ki bunu biliyor.",
          "pauseAfterMs": 5000,
          "textKey": "episode_20.ep20_n06_son_not.event9.text"
        },
        {
          "type": "realTimeWait",
          "seconds": 6
        },
        {
          "type": "typing",
          "speaker": "JONES",
          "duration": 4000
        },
        {
          "type": "message",
          "speaker": "JONES",
          "text": "Emre hâlâ Emre. İçeride. Kendi seçimiyle. Ve bunu anlattım.",
