        { "type": "typing", "speaker": "JONES", "duration": 3500 },
        { "type": "message", "speaker": "JONES", "text": "Basın kartı. Benim. İki yıl önceki bir iş gezisinden, Hatay'dan.", "pauseAfterMs": 4500 },
