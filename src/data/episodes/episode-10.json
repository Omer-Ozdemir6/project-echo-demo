        { "type": "typing", "speaker": "JONES", "duration": 3200 },
        { "type": "message", "speaker": "JONES", "text": "Ve şu an elimde tutuyorum. Bu kart burada olması gereken tek şey. Ben kayıt yapan biriyim. Ama hiçbir şey kayıt edemedim.", "pauseAfterMs": 5000 },
