        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "\"Güneş. Bir şey anlamadım. Neden senin hafızan sıfırlanmıyor?\"", "pauseAfterMs": 4000 },
