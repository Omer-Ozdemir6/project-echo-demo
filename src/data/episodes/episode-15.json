        { "type": "message", "speaker": "JONES", "text": "\"Selin biliyor mu?\"", "pauseAfterMs": 3500 },
        { "type": "realTimeWait", "seconds": 8 },
        { "type": "typing", "speaker": "JONES", "duration": 4000 },
        { "type": "message", "speaker": "JONES", "text": "Güneş uzun düşündü. \"Selin ne bildiğini bilmiyor\" dedi.", "pauseAfterMs": 4500 },
        { "type": "typing", "speaker": "JONES", "duration": 3000 },
        { "type": "message", "speaker": "JONES", "text": "\"Bu ne anlama geliyor?\"", "pauseAfterMs": 3500 },
        { "type": "typing", "speaker": "JONES", "duration": 4500 },
        { "type": "message", "speaker": "JONES", "text": "\"Babası 1987'de onlarla temas etti. Ve o temas kapandığında içinde bir şey bıraktı — bir kanal. Selin bu kanaldan bilgi alıyor. Ama kanalın nereden geldiğini bilmiyor.\"", "pauseAfterMs": 5500 },
