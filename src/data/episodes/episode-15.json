        { "type": "message", "speaker": "JONES", "text": "Selin'e kızamıyorum. Babası 1987'de bir şey bıraktı onda. Fark etmeden taşıyor. Biz hepimiz bir şeyleri fark etmeden taşıyoruz.", "pauseAfterMs": 5000 },
